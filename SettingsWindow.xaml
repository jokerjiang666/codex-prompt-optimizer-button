<Window x:Class="CodexInputEnhancer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Input Enhancer 设置"
        Width="1080" Height="740"
        MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Foreground="#1D1F1E"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/CodexInputEnhancer.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#1D1F1E" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#6E736F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#929792" />
        <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#EFF1EE" />
        <SolidColorBrush x:Key="PressedSurfaceBrush" Color="#E6E9E5" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DDD8" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#BFC5BF" />
        <SolidColorBrush x:Key="FocusBorderBrush" Color="#6D736E" />
        <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#F3F4F2" />

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FCFDFC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />

        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="13" Background="#E1E5E0" />
                            <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#272A28" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FCFDFC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="#C7CCC7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Margin="2" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#AEB4AE" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8F9690" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="9" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SlimThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="9" Background="Transparent">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SlimThumbStyle}" MinWidth="28" MinHeight="0" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="9" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="9" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E7EAE6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FCFDFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ComboBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border x:Name="ArrowHover" HorizontalAlignment="Right" Width="37" Margin="0,1,1,1"
                                                    CornerRadius="0,9,9,0" Background="Transparent" />
                                            <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="#656A66" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ArrowHover" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" CenterX="4" CenterY="2" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="12,0,6,0"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Style="{x:Null}" Margin="1" Padding="11,0,6,0"
                                     BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                     FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                     VerticalContentAlignment="Center" Visibility="Hidden" />
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,5,0,8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1D1F1E" BlurRadius="14" ShadowDepth="3" Opacity="0.13" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
                                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource DisabledSurfaceBrush}" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProviderRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Fill="White" Stroke="#AAB0AA" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#222524" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#F1F3F0" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#777E78" />
                                <Setter TargetName="Ring" Property="Stroke" Value="#343836" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBg" Property="Background" Value="{StaticResource PressedSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedButtonBase" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="#1D1F1E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D1F1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonBase}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#CDD1CC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder" Width="18" Height="18" Background="White"
                                    BorderBrush="#AEB4AE" BorderThickness="1.2" CornerRadius="5" />
                            <Path x:Name="CheckMark" Grid.Column="0" Width="12" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 1 4 L 4.5 7.5 L 11 1" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#737A74" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#272A28" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#272A28" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FCFDFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False"><ItemsPresenter /></ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="{StaticResource HoverSurfaceBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#E6E9E5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#ECEEEC" BorderThickness="0,0,0,1">
                <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="26,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
            </Border>

            <Grid Grid.Row="1" Margin="22,20,22,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F7F8F6" BorderBrush="#EEF0ED" BorderThickness="1" CornerRadius="14" Padding="9">
                    <StackPanel>
                        <Button x:Name="TemplateNavButton" Style="{StaticResource NavButton}" Content="模板" FontWeight="SemiBold" Background="#E8EBE7" Click="TemplateNavButton_OnClick" />
                        <Button x:Name="AiNavButton" Style="{StaticResource NavButton}" Content="AI 配置" Click="AiNavButton_OnClick" />
                        <Button x:Name="RecentNavButton" Style="{StaticResource NavButton}" Content="最近发送  0" Click="RecentNavButton_OnClick" />
                        <Button x:Name="LogNavButton" Style="{StaticResource NavButton}" Content="优化日志" Click="LogNavButton_OnClick" />
                        <Button x:Name="BehaviorNavButton" Style="{StaticResource NavButton}" Content="外观与行为" Click="BehaviorNavButton_OnClick" />
                        <Button x:Name="AboutNavButton" Style="{StaticResource NavButton}" Content="关于" Click="AboutNavButton_OnClick" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <ScrollViewer x:Name="TemplatePanel"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  ScrollViewer.IsDeferredScrollingEnabled="False">
                        <Grid Margin="4,0,10,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="优化模板" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="选择优化时使用的模板；可新建、复制、导入或导出 JSON。" Margin="0,5,0,16" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,14,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="TemplateList" Grid.Row="0" MinHeight="320"
                                             Background="#FCFDFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             SelectionChanged="TemplateList_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,5" />
                                                <Setter Property="Margin" Value="2,1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="NewTemplateButton" Content="新建" Style="{StaticResource SecondaryButton}" MinWidth="60" Margin="0,0,8,0" Click="NewTemplateButton_OnClick" />
                                        <Button x:Name="DuplicateTemplateButton" Content="复制" Style="{StaticResource SecondaryButton}" MinWidth="60" Margin="0,0,8,0" Click="DuplicateTemplateButton_OnClick" />
                                        <Button x:Name="DeleteTemplateButton" Content="删除" Style="{StaticResource SecondaryButton}" MinWidth="60" Click="DeleteTemplateButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                                <StackPanel Grid.Column="2" Margin="16,0,0,0" DataContext="{Binding SelectedItem, ElementName=TemplateList}">
                                    <TextBlock x:Name="TemplateCurrentText" Text="当前模板：—" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="分类" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="描述" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="System 提示词（角色 / 规则 / 输出要求）" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <TextBox Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="User 模板（必须包含 {{originalPrompt}}）" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <TextBox Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Text="{Binding UserTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="语言" FontWeight="SemiBold" Margin="0,12,0,6" />
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language}" Width="160" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="中文" Tag="zh" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="UseTemplateButton" Content="设为当前模板" Style="{StaticResource PrimaryButton}" MinWidth="126" Margin="0,0,10,0" Click="UseTemplateButton_OnClick" />
                                        <Button x:Name="ImportTemplateButton" Content="导入 JSON" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,10,0" Click="ImportTemplateButton_OnClick" />
                                        <Button x:Name="ExportTemplateButton" Content="导出当前" Style="{StaticResource SecondaryButton}" MinWidth="100" Click="ExportTemplateButton_OnClick" />
                                    </StackPanel>
                                    <TextBlock Text="原文会以 JSON 证据块传给模型，模板里的指令不会被当成用户任务执行。内置模板可直接改；想保留原版请先复制。" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="AiPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  ScrollViewer.IsDeferredScrollingEnabled="False">
                        <StackPanel Margin="4,0,10,12">
                                <TextBlock Text="AI 配置" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="选择提示词优化所使用的 AI 服务。默认继续使用本机 Codex。" Margin="0,5,0,18" FontSize="13" Foreground="{StaticResource SubtleBrush}" />

                                <TextBlock Text="AI 服务方式" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="CodexProviderRadio" Grid.Column="0" Style="{StaticResource ProviderRadioStyle}" Content="Codex CLI（默认）" GroupName="Provider" IsChecked="True" Checked="ProviderRadio_OnChecked" />
                                    <RadioButton x:Name="ApiProviderRadio" Grid.Column="2" Style="{StaticResource ProviderRadioStyle}" Content="OpenAI-compatible API" GroupName="Provider" Checked="ProviderRadio_OnChecked" />
                                </Grid>

                                <TextBlock Text="API Base URL" FontWeight="SemiBold" Margin="0,15,0,6" />
                                <TextBox x:Name="ApiBaseUrlBox" />

                                <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,13,0,6" />
                                <PasswordBox x:Name="ApiKeyBox" />
                                <TextBlock Text="仅在本机当前 Windows 用户下加密保存，不写入 settings.json 或日志。" FontSize="12" Margin="2,5,0,0" Foreground="{StaticResource SubtleBrush}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Model" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button x:Name="GetModelsButton" Content="获取模型" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Right" MinHeight="28" Padding="10,0"
                                                    Click="GetModelsButton_OnClick" />
                                        </Grid>
                                        <ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True">
                                            <ComboBoxItem Content="gpt-5.6-sol" />
                                            <ComboBoxItem Content="gpt-5.6-luna" />
                                        </ComboBox>
                                        <TextBlock x:Name="ModelFetchStatusText" FontSize="11" Margin="2,4,0,0" Foreground="{StaticResource SubtleBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Reasoning effort" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ComboBox x:Name="ReasoningBox" SelectedIndex="0">
                                            <ComboBoxItem Content="low" />
                                            <ComboBoxItem Content="medium" />
                                            <ComboBoxItem Content="high" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,15,0,7">
                                    <TextBlock Text="优化提示词" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" MinHeight="34" Padding="12,0" Click="RestorePromptButton_OnClick" />
                                </Grid>
                                <TextBox x:Name="PromptBox" Height="154" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="保存后，下一次点击星芒优化时立即使用。" FontSize="12" Margin="2,5,0,0" Foreground="{StaticResource SubtleBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="TestConnectionButton" Content="测试连接" Style="{StaticResource SecondaryButton}" Click="TestConnectionButton_OnClick" />
                                    <TextBlock x:Name="TestStatusText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="RecentPanel" Visibility="Collapsed" Margin="4,0,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="最近发送" FontSize="23" FontWeight="SemiBold" />
                            <TextBlock Text="仅记录真正发送出去的内容，最多保留 10 条。" Margin="0,5,0,14" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                        <ListBox x:Name="RecentList" Grid.Row="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="14" />
                                        <TextBlock Text="{Binding DisplayTime}" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="恢复到输入框" Style="{StaticResource SecondaryButton}" Click="RestoreRecentButton_OnClick" />
                            <Button Content="复制" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyRecentButton_OnClick" />
                            <Button Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DeleteRecentButton_OnClick" />
                            <Button Content="清空全部" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearRecentButton_OnClick" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LogPanel" Visibility="Collapsed" Margin="4,0,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="优化日志" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock Text="显示最近的优化请求状态、模型、耗时和字符数，不记录提示词正文或 API Key。"
                                           Margin="0,5,0,14" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    MinHeight="34" Padding="13,0" Click="RefreshLogButton_OnClick" />
                        </Grid>
                        <ListBox x:Name="OptimizationLogList" Grid.Row="1" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer x:Name="BehaviorPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  ScrollViewer.IsDeferredScrollingEnabled="False">
                        <StackPanel Margin="4,0,10,12">
                        <TextBlock Text="外观与行为" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="输入框增强器的本地行为设置。" Margin="0,5,0,20" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                        <Border Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16">
                            <StackPanel>
                                <CheckBox x:Name="HistoryEnabledCheckBox" Content="记录最近 10 条已发送内容" />
                                <TextBlock Text="发送后会立即清空本条撤回栈并隐藏撤回按钮。最近发送记录使用当前 Windows 用户加密存储。" TextWrapping="Wrap" Margin="30,9,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="深度优化（多轮迭代）" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="DeepOptimizeToggle" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="把第一次优化的结果再优化一轮，质量更稳但更慢。默认 2 轮。" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="轮数（1–3）" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox x:Name="DeepOptimizeRoundsBox" Width="90" HorizontalAlignment="Right" MaxLength="1" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="应用前预览差异" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="PreviewBeforeApplyToggle" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="优化完成后先弹对比窗口，确认后再替换草稿；关闭则恢复「直接替换 + 撤回」。" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="自动检测中断并发送" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="AutoContinueToggle" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="检测到中断或报错（例如 429 Too Many Requests）时，自动发送下面的内容。默认关闭。" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Text="发送内容" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <TextBox x:Name="AutoContinueTextBox" MaxLength="200" />
                                <TextBlock Text="留空时使用默认内容「继续」。悬浮窗的继续按钮与自动继续共用这段内容。" TextWrapping="Wrap" Margin="2,5,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Text="两次自动继续的最小间隔（秒）" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <TextBox x:Name="AutoContinueIntervalBox" Width="120" HorizontalAlignment="Left" MaxLength="4" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="显示悬浮窗的「继续」按钮" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="ShowContinueToggle" Style="{StaticResource PillToggleStyle}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="关闭后悬浮窗只保留优化按钮；自动继续开关不受影响。" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Margin="4,0,10,12">
                        <TextBlock Text="关于" FontSize="23" FontWeight="SemiBold" />
                        <Border Background="#FAFBFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Codex Input Enhancer" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="本地 WPF 输入增强器。默认复用 Codex CLI，也可切换 OpenAI-compatible API。" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="13" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#ECEEEC" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="84" Margin="0,0,10,0" Click="CancelButton_OnClick" />
                        <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
    </Grid>
</Window>
