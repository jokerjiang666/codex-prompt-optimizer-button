<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CodexInputEnhancer</AssemblyName>
    <RootNamespace>CodexInputEnhancer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CodexInputEnhancer.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <!-- 保留 app.manifest 的 PerMonitorV2（悬浮窗定位依赖它）；这里只是 WinForms 分析器的建议性告警。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <!-- tests/ 下有独立的离线断言工程（由 tests\ContextTests\ContextTests.csproj 构建），不参与主工程编译。 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\CodexInputEnhancer.ico" />
    <Content Include="Assets\optimize-loading-v2-icon.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
